    <script>
        // Toggle disable time picker when "Unknown birth time" is checked
        const unknownCheck = document.getElementById('birth_time_unknown');
        const hourSel = document.getElementById('birth_hour');
        const minSel = document.getElementById('birth_minute');
        const timeInput = document.getElementById('birth_time');

        if (unknownCheck) {
            unknownCheck.addEventListener('change', function() {
                if (this.checked) {
                    hourSel.disabled = true;
                    minSel.disabled = true;
                    timeInput.value = '';
                } else {
                    hourSel.disabled = false;
                    minSel.disabled = false;
                    const h = String(hourSel.value).padStart(2, '0');
                    const m = String(minSel.value).padStart(2, '0');
                    timeInput.value = `${h}:${m}`;
                }
            });
        }
    </script>
